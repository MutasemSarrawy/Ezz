<%- include('partials/head') %>
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy reveal">
      <p class="eyebrow"><span class="dot"></span> Enrollment <%= course.enrollment_open ? 'open' : 'opening soon' %> · <%= course.title %></p>
      <h1 class="display">Learn AI the way you’ll <em>actually use it.</em></h1>
      <p class="lead">Sarrawy Academy turns artificial intelligence from a buzzword into a working skill. Clear lessons, real projects, and honest guidance on what AI can and can’t do.</p>
      <div class="actions">
        <a class="btn" href="/course">Explore The AI Master</a>
        <a class="btn btn-ghost" href="/resources">Start free</a>
      </div>
    </div>
    <aside class="hero-card reveal" aria-label="Course at a glance">
      <div class="hero-card-top">
        <span class="mono muted">Course 01</span>
        <span class="tag"><%= course.level %></span>
      </div>
      <h2 class="serif-lg"><%= course.title %></h2>
      <p class="muted"><%= course.tagline %></p>
      <ol class="mini-modules">
        <% modules.slice(0, 4).forEach((m) => { %>
          <li><span class="mono"><%= String(m.position).padStart(2, '0') %></span><%= m.title %></li>
        <% }) %>
        <% if (modules.length > 4) { %><li class="muted"><span class="mono">+<%= modules.length - 4 %></span>more modules</li><% } %>
      </ol>
      <dl class="facts">
        <div><dt>Duration</dt><dd><%= course.duration %></dd></div>
        <div><dt>Format</dt><dd><%= course.format %></dd></div>
      </dl>
    </aside>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">How we teach</p>
      <h2 class="display-md">Less hype. More practice.</h2>
    </div>
    <div class="bento">
      <article class="tile tile-wide reveal">
        <span class="tile-num mono">01</span>
        <h3>Projects from week one</h3>
        <p>Every module ends with something you build and keep — a prompt library, an automated workflow, a working AI tool. You leave with a portfolio, not a pile of notes.</p>
      </article>
      <article class="tile tile-accent reveal">
        <span class="tile-num mono">02</span>
        <h3>Plain language</h3>
        <p>No jargon walls. Concepts are explained simply, then made precise.</p>
      </article>
      <article class="tile reveal">
        <span class="tile-num mono">03</span>
        <h3>Honest about limits</h3>
        <p>You’ll learn where AI fails, and how to check its work.</p>
      </article>
      <article class="tile tile-wide reveal">
        <span class="tile-num mono">04</span>
        <h3>Built for busy people</h3>
        <p>Self-paced lessons with live sessions for questions and feedback. Learn alongside work or study, at a pace that sticks.</p>
      </article>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap split">
    <div class="reveal">
      <p class="eyebrow">Free sources</p>
      <h2 class="display-md">Start learning today, for free.</h2>
      <p class="lead muted">We keep a short, hand-picked list of the best free AI material on the web — the resources we’d recommend to a friend.</p>
      <a class="link-arrow" href="/resources">See all free sources</a>
    </div>
    <ul class="resource-list reveal">
      <% resources.forEach((r) => { %>
        <li>
          <a href="<%= r.url %>" target="_blank" rel="noopener noreferrer nofollow">
            <span class="tag tag-soft"><%= r.kind %></span>
            <strong><%= r.title %></strong>
            <span class="muted"><%= r.description %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap cta reveal">
    <h2 class="display-md">Ready to become an <em>AI Master</em>?</h2>
    <p class="lead muted">Apply in two minutes. We’ll reply within two working days.</p>
    <div class="actions center">
      <a class="btn" href="/course#apply">Apply for the course</a>
      <a class="btn btn-ghost" href="/contact">Ask a question</a>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
