<%- include('_head') %>
<div class="login-card card">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">S</span><span class="brand-name">Sarrawy <em>Academy</em></span></a>
  <h1 class="serif-lg">Admin sign in</h1>
  <% if (error) { %><p class="notice notice-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="<%= adminPath %>/login" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="<%= email %>" autocomplete="username" maxlength="200" required autofocus>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required>
    </div>
    <button class="btn btn-block" type="submit">Sign in</button>
  </form>
</div>
<%- include('_foot') %>
