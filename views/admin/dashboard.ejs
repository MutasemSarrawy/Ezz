<%- include('_head') %>
<header class="admin-header">
  <div><p class="eyebrow">Overview</p><h1 class="serif-lg">Welcome back, <%= admin.name %></h1></div>
</header>
<div class="stats">
  <a class="stat" href="<%= adminPath %>/messages"><span class="stat-num"><%= stats.unread %></span><span class="muted">Unread messages</span><span class="small muted"><%= stats.messages %> total</span></a>
  <a class="stat" href="<%= adminPath %>/enrollments"><span class="stat-num"><%= stats.newEnrollments %></span><span class="muted">New applications</span><span class="small muted"><%= stats.enrollments %> total</span></a>
  <a class="stat" href="<%= adminPath %>/resources"><span class="stat-num"><%= stats.resources %></span><span class="muted">Published free sources</span></a>
  <a class="stat" href="<%= adminPath %>/chats"><span class="stat-num"><%= stats.chatsWeek %></span><span class="muted">Chat questions</span><span class="small muted">last 7 days</span></a>
</div>
<div class="admin-cols">
  <section class="card">
    <div class="card-head"><h2>Latest messages</h2><a class="small" href="<%= adminPath %>/messages">View all</a></div>
    <% if (!recentMessages.length) { %><p class="muted">No messages yet.</p><% } %>
    <ul class="rows">
      <% recentMessages.forEach((m) => { %>
        <li><a href="<%= adminPath %>/messages/<%= m.id %>"><strong><% if (!m.is_read) { %><span class="pip" title="Unread"></span><% } %><%= m.subject %></strong><span class="muted small"><%= m.name %> · <%= new Date(m.created_at).toISOString().slice(0, 10) %></span></a></li>
      <% }) %>
    </ul>
  </section>
  <section class="card">
    <div class="card-head"><h2>Latest applications</h2><a class="small" href="<%= adminPath %>/enrollments">View all</a></div>
    <% if (!recentEnrollments.length) { %><p class="muted">No applications yet.</p><% } %>
    <ul class="rows">
      <% recentEnrollments.forEach((e) => { %>
        <li><span><strong><%= e.name %></strong><span class="muted small"><%= e.level %> · <%= new Date(e.created_at).toISOString().slice(0, 10) %></span></span><span class="badge badge-<%= e.status %>"><%= e.status %></span></li>
      <% }) %>
    </ul>
  </section>
</div>
<%- include('_foot') %>
