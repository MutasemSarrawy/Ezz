<%- include('_head') %>
<header class="admin-header"><div><p class="eyebrow">Settings</p><h1 class="serif-lg">Account</h1></div></header>
<% if (saved) { %><p class="notice notice-success" role="status">Password updated. Other sessions have been signed out.</p><% } %>
<form class="card form form-narrow" method="post" action="<%= adminPath %>/account/password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2>Change password</h2>
  <p class="muted small">At least 12 characters, mixing three of: lowercase, uppercase, numbers and symbols.</p>
  <% if (errors.length) { %><div class="notice notice-error" role="alert"><% errors.forEach((e) => { %><p><%= e %></p><% }) %></div><% } %>
  <div class="field"><label for="cp">Current password</label><input id="cp" name="current_password" type="password" autocomplete="current-password" maxlength="200" required></div>
  <div class="field"><label for="np">New password</label><input id="np" name="new_password" type="password" autocomplete="new-password" minlength="12" maxlength="200" required></div>
  <div class="field"><label for="cf">Confirm new password</label><input id="cf" name="confirm_password" type="password" autocomplete="new-password" minlength="12" maxlength="200" required></div>
  <button class="btn" type="submit">Update password</button>
</form>
<%- include('_foot') %>
