# Copy to .env (or set in your hosting dashboard). Never commit real values.
NODE_ENV=production
PORT=3000
# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Where the SQLite database lives (keep it outside the web root and back it up)
DATA_DIR=./data
# Number of reverse proxies in front of the app (1 behind nginx / Render / Railway etc.)
TRUST_PROXY=1
# Optional: move the admin panel to a hard-to-guess path
ADMIN_PATH=/admin
CONTACT_EMAIL=mutasem@sarrawy.com
# Optional: enable the AI-powered chat assistant (falls back to the built-in FAQ bot without it)
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-opus-5-5
